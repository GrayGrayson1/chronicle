DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
# Optional: restrict registration to selected servers. If blank, Chronicle
# registers commands automatically in every server where this private bot is installed.
DISCORD_GUILD_ID=

# Dedicated local data directory. No API key is needed.
DATA_DIR=./data
# Windows npm installations are detected automatically. A codex.js path also works.
CODEX_BIN=codex
# Optional: leave empty to let Codex choose its default model.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=240
# Full path to the Python in your virtual environment.
# Windows example: .venv/Scripts/python.exe
PYTHON_BIN=python3
# Accuracy-focused defaults for Jon's NVIDIA RTX 5080.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=en
# large-v3 also supports other languages. Use auto for language detection.
# CPU fallback (slower): WHISPER_DEVICE=cpu, WHISPER_COMPUTE_TYPE=int8.
MAX_SESSION_HOURS=6
MAX_PENDING_AUDIO=300

# Local recorder settings (no Discord credentials needed in local mode).
LOCAL_CAMPAIGN=My campaign
LOCAL_SPEAKER=You
CAMPAIGN_GLOSSARY=
# Leave blank for system defaults. Use device names from npm run doctor.
MIC_DEVICE=
PLAYBACK_DEVICE=

# Dashboard (starts with npm start, or npm run dashboard without Discord).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Optional exact browser origins, e.g. http://localhost:30000 for Foundry.
DASHBOARD_ALLOWED_ORIGINS=
# Additional server IDs, comma-separated. Leave blank for automatic registration.
DISCORD_EXTRA_GUILD_IDS=
# Optional extra bots for simultaneous sessions; invite each to your server.
DISCORD_COMPANION_TOKENS=[]
# Play-by-post message ingestion and automatic RP image imports require Message Content.
# When enabled, choose the channel in dashboard Settings; text posts become review source.
ENABLE_PLAY_BY_POST=0

# Optional local semantic search: install requirements-full.txt, then enable.
SEMANTIC_SEARCH=0
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DEVICE=cpu
# Optional mixed-audio speaker discovery: install requirements-diarization.txt,
# accept the model's access terms at Hugging Face, and set a READ token.
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cpu

# Optional local image generation. Install ComfyUI and a compatible checkpoint.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=

# Optional email sending. Each delivery is confirmed, or a member opts into a topic.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional local fonts for multilingual PDFs.
PDF_FONT=
PDF_FONT_BOLD=

# Optional local text-tone model (not a measure of players’ emotions).
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Player site (GitHub Pages). Publishes approved, party-visible material to site/data,
# encrypted with SITE_PASSPHRASE. Share that password with the group in Discord.
SITE_PASSPHRASE=
# 1 = refresh the site automatically after each approved session review.
SITE_AUTO_PUBLISH=0
# 1 = commit site/data and git push after publishing (needs push access to the repo).
SITE_GIT_PUSH=0
# The public address of the site; the bot posts it after publishing.
SITE_URL=https://graygrayson1.github.io/chronicle/
# Optional: include full transcripts on the site (still encrypted). Off by default.
SITE_INCLUDE_TRANSCRIPTS=0
# Optional: campaign title shown before unlocking (defaults to the campaign name).
SITE_TITLE=
# Only if you really want an unencrypted site: SITE_PUBLIC=1 and leave SITE_PASSPHRASE empty.
SITE_PUBLIC=0
